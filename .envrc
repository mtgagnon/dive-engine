# Define the project directory
export PROJECT_DIR=$(pwd)

# ─── Platform detection ────────────────────────────────────────────────────────
OS="$(uname -s)"

if [[ "$OS" == "Darwin" ]]; then
    # macOS: LunarG Vulkan SDK — pick the latest version-numbered directory (x.x.x.x)
    VULKAN_VERSION=$(ls "$HOME/VulkanSDK" | grep -E '^[0-9]+\.[0-9]+\.[0-9]+' | sort -V | tail -1)
    source "$HOME/VulkanSDK/$VULKAN_VERSION/setup-env.sh"
elif [[ "$OS" == "Linux" ]]; then
    # Linux (Ubuntu / WSL): prefer LunarG SDK if present, otherwise rely on
    # system packages (apt install libvulkan-dev) — CMake finds those automatically.
    if [[ -n "$VULKAN_SDK" ]]; then
        # Already set externally (e.g. sourced setup-env.sh), just export it.
        export VULKAN_SDK
    elif [[ -d "$HOME/vulkan" ]]; then
        # LunarG SDK installed to ~/vulkan/<version>/
        VULKAN_VERSION=$(ls "$HOME/vulkan" | sort -V | tail -1)
        export VULKAN_SDK="$HOME/vulkan/$VULKAN_VERSION/x86_64"
        PATH_add "$VULKAN_SDK/bin"
        export LD_LIBRARY_PATH="$VULKAN_SDK/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
        export VK_LAYER_PATH="$VULKAN_SDK/etc/vulkan/explicit_layer.d"
    fi
    # else: system headers + loader found automatically by CMake — nothing to set.
fi

# ─── CMake build commands ──────────────────────────────────────────────────────

# Debug build (Unix Makefiles — works on macOS and Linux)
export BUILD_LINUX_D="
cmake \
  -G 'Unix Makefiles' \
  -DCMAKE_VERBOSE_MAKEFILE=ON \
  -DCMAKE_EXPORT_COMPILE_COMMANDS=ON \
  -DCMAKE_C_COMPILER=clang \
  -DCMAKE_CXX_COMPILER=clang++ \
  -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
  -S $PROJECT_DIR \
  -B $PROJECT_DIR/builds/build-debug \
  -DCMAKE_BUILD_TYPE=Debug
"

# Release build
export BUILD_LINUX_R="
cmake \
  -G 'Unix Makefiles' \
  -DCMAKE_EXPORT_COMPILE_COMMANDS=ON \
  -DCMAKE_C_COMPILER=clang \
  -DCMAKE_CXX_COMPILER=clang++ \
  -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
  -S $PROJECT_DIR \
  -B $PROJECT_DIR/builds/build-release \
  -DCMAKE_BUILD_TYPE=Release
"

# macOS Xcode build
export BUILD_MAC_D="
cmake \
  -G 'Xcode' \
  -DCMAKE_EXPORT_COMPILE_COMMANDS=ON \
  -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
  -S $PROJECT_DIR \
  -B $PROJECT_DIR/builds/build-xcode \
  -DCMAKE_BUILD_TYPE=Debug
"

export BUILD_MAC_R="
cmake \
  -G 'Xcode' \
  -DCMAKE_EXPORT_COMPILE_COMMANDS=ON \
  -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
  -S $PROJECT_DIR \
  -B $PROJECT_DIR/builds/build-xcode \
  -DCMAKE_BUILD_TYPE=Release
"

# Symlink compile_commands.json to project root for IDE support
export LINK_COMPILE_COMMANDS="ln -sf $PROJECT_DIR/builds/build-debug/compile_commands.json $PROJECT_DIR/compile_commands.json"

# Add project scripts to PATH (provides build and run commands)
PATH_add $PROJECT_DIR/scripts
