# Define the project directory
export PROJECT_DIR=$(pwd)

# Define CMake command for Debug Linux build
export BUILD_LINUX_D="
cmake \
  -G 'Unix Makefiles' \
  -DCMAKE_VERBOSE_MAKEFILE=ON \
  -DCMAKE_EXPORT_COMPILE_COMMANDS=ON \
  -DCMAKE_C_COMPILER=clang \
  -DCMAKE_CXX_COMPILER=clang++ \
  -S $PROJECT_DIR \
  -B $PROJECT_DIR/builds/build-debug \
  -DCMAKE_BUILD_TYPE=Debug
"

# Define CMake command for Release Linux build
export BUILD_LINUX_R="
cmake \
  -G 'Unix Makefiles' \
  -DCMAKE_EXPORT_COMPILE_COMMANDS=ON \
  -DCMAKE_C_COMPILER=clang \
  -DCMAKE_CXX_COMPILER=clang++ \
  -S $PROJECT_DIR \
  -B $PROJECT_DIR/builds/build-release \
  -DCMAKE_BUILD_TYPE=Release
"

# Define CMake command for Debug Mac build
export BUILD_MAC="
cmake \
  -G 'Xcode' \
  -DCMAKE_EXPORT_COMPILE_COMMANDS=ON \
  -S $PROJECT_DIR \
  -B $PROJECT_DIR/builds/build-xcode \
  -DCMAKE_BUILD_TYPE=Debug
"

# Symlink compile_commands.json to project root for IDE support
export LINK_COMPILE_COMMANDS="
ln -sf $PROJECT_DIR/builds/build-debug/compile_commands.json $PROJECT_DIR/compile_commands.json
"

# Add project scripts to PATH (provides build and run commands)
PATH_add $PROJECT_DIR/scripts
